# Referência de configuração. Este arquivo não é carregado automaticamente.
# Copiar para .env não configura os processos; defina as variáveis no ambiente.

# API: caminho relativo ao diretório de execução do processo.
# Execute a API a partir da raiz do repositório para usar o projects.db dessa pasta.
# Defina antes de iniciar a API; reinicie-a se alterar esta variável.
# PowerShell (terminal da API): $env:DATABASE_URL = "sqlite:///./projects.db"
# Exemplo absoluto no Windows: sqlite:///C:/dados/workflow/projects.db
DATABASE_URL=sqlite:///./projects.db

# Interface Streamlit: endereço da API, definido antes de iniciar a interface.
# PowerShell (terminal da interface): $env:API_BASE_URL = "http://127.0.0.1:8000"
API_BASE_URL=http://127.0.0.1:8000
